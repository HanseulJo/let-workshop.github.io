      </symbol>
      <symbol id="i-cal" viewBox="0 0 24 24">
        <path d="M7 2v2H5.5A2.5 2.5 0 003 6.5v13A2.5 2.5 0 005.5 22h13a2.5 2.5 0 002.5-2.5v-13A2.5 2.5 0 0018.5 4H17V2h-2v2H9V2zm12 8v9.5a.5.5 0 01-.5.5h-13a.5.5 0 01-.5-.5V10z" />
