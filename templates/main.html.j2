{#- The name, split on its last space so the year can sit back from it. Used by
    both the hero title and the sticky bar: two different cuts of "KOLT 2026" on
    one screen is the kind of thing you notice without being able to say why. A
    name with no space just renders whole. -#}
{%- macro wordmark(name) -%}
  {%- set parts = name.rsplit(" ", 1) if " " in name else [name] -%}
  <b>{{ parts[0] }}</b>{% if parts|length > 1 %} <span class="year">{{ parts[1] }}</span>{% endif %}
{%- endmacro -%}
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ site.name }} — {{ site.full_name }}</title>
    {% if variant.noindex %}
    <!-- Keep this page out of search results for now (still shareable via direct link) -->
    <meta name="robots" content="noindex, follow" />
    {% endif %}
    <meta name="description" content="{{ site.description }}" />
    <link rel="canonical" href="{{ site.url }}" />
    {% if venue.map.resolved == 'leaflet' %}
    <link rel="stylesheet" href="vendor/leaflet/leaflet.css" />
    {% endif %}
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="favicon-180.png" />
    <meta name="theme-color" content="#1a3a6b" />
    <script>
      // Before first paint, or the page renders light and then snaps to dark.
      // "auto" stores nothing on the element so prefers-color-scheme decides.
      (function () {
        try {
          var t = localStorage.getItem("kolt-theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          /* private browsing — the choice just doesn't persist */
        }
      })();
    </script>
    <!-- Open Graph (Facebook, Slack, KakaoTalk, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}" />
    <meta property="og:title" content="{{ site.name }} — {{ site.full_name }}" />
    <meta property="og:description" content="{{ site.tagline }}. {{ site.blurb }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_US" />
    <!-- The card is the page's own hero, rendered by tools/make-og.py, so the
         preview cannot drift from the site. Absolute URL because a scraper has
         no page to resolve a relative one against; site.url is derived per
         deployment target, so each host advertises its own copy. -->
    <meta property="og:image" content="{{ site.url }}og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.name }} — {{ site.tagline }}" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ site.name }} — {{ site.full_name }}" />
    <meta name="twitter:description" content="{{ site.tagline }}." />
    <meta name="twitter:image" content="{{ site.url }}og.jpg" />
    <!-- Legacy, and still what some Korean scrapers read first. Without any of
         these a scraper falls back to the first <img> in the document, which
         here is whichever speaker sorts first alphabetically — a stranger's
         face as the card for the workshop. -->
    <link rel="image_src" href="{{ site.url }}og.jpg" />
    {% if variant.analytics %}
    <!-- Google tag (gtag.js) — this page is served statically, outside Hugo, so GA is added directly -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "{{ site.analytics_id }}");
    </script>
    {% endif %}
    <style>
{% filter indent(6, true) %}{% include "style.css" %}{% endfilter %}

      /* Event colours — generated from `types` in data/program.yml. Each type
         resolves to a custom property so the dark theme restates four values
         per type instead of repeating every rule that consumes them. */
      {% for key, t in types.items() %}
      .bg-{{ key }},
      .sw-{{ key }} {
        background: var(--t-{{ key }}-fill);
        border-left-color: {{ t.color }};
      }
      .badge-{{ key }} {
        background: var(--t-{{ key }}-badge);
        color: var(--t-{{ key }}-deep);
      }
      .wash-{{ key }} {
        background: var(--t-{{ key }}-wash);
      }
      .strip-{{ key }} {
        background: {{ t.color }};
      }
      {% endfor %}
      :root {
        {% for key, t in types.items() %}
        --t-{{ key }}-fill: {{ t.fill }};
        --t-{{ key }}-wash: {{ t.wash }};
        --t-{{ key }}-badge: {{ t.badge }};
        --t-{{ key }}-deep: {{ t.deep }};
        {% endfor %}
      }
      {% set dark %}
        {% for key, t in types.items() %}
        --t-{{ key }}-fill: {{ t.fill_dark }};
        --t-{{ key }}-wash: {{ t.wash_dark }};
        --t-{{ key }}-badge: {{ t.badge_dark }};
        --t-{{ key }}-deep: {{ t.deep_dark }};
        {% endfor %}
      {% endset %}
      [data-theme="dark"] { {{ dark }} }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) { {{ dark }} }
      }
    </style>
  </head>
  <body>
    <!-- Icon sprite: inline so no icon files or icon-font requests ship -->
