<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{ r.label }}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="{{ r.to }}" />
    <meta http-equiv="refresh" content="0; url={{ r.to }}" />
    <meta name="robots" content="noindex, follow" />
    <script>
      window.location.replace("{{ r.to }}" + window.location.hash);
    </script>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background: #f9fafb;
        color: #46506b;
      }
      a {
        color: #1a3a6b;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <p>Redirecting to <a href="{{ r.to }}">{{ r.label }}</a>…</p>
  </body>
</html>
